# Copiar a .env y completar. .env NUNCA se commitea (está en .gitignore).
# cp .env.example .env

# Proveedor del chain RAG de Entrega 3: openai o gemini
RAG_PROVIDER=gemini

# Clave para Entrega 1
OPENAI_API_KEY=
# Modelo de OpenAI (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Clave y modelo para usar Gemini en Entrega 3
GEMINI_API_KEY=
GEMINI_MODEL=

# Timeout en segundos por llamada (default: 30)
OPENAI_TIMEOUT=30

# LangSmith (activar localmente para ejecutar la traza B.4)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=iads3-dsi

# Otras variables de Entrega 1
# Confianza mínima para no derivar a un humano (default: 0.60)
UMBRAL_CONFIANZA=0.60

# --- TP Final: API del agente (Partes B, C y D) ---
# Tokens de demo: "token:cliente_id" separados por comas. Identidad fija para
# demo y tests, NO es autenticación de producción. Generá tokens propios.
API_CLIENTES=
# Secreto para aislar los hilos por cliente (mínimo 32 caracteres aleatorios).
# Generalo con: python -c "import secrets; print(secrets.token_hex(32))"
HILOS_SECRETO=
# Rutas locales (no versionadas)
RUTA_MEMORIA=runtime/checkpoints.sqlite
RUTA_DB_NEGOCIO=runtime/ecologix.db

# Observabilidad (Parte C)
# Consultas mínimas antes de publicar p95 y evaluar la alerta de latencia
MUESTRA_MINIMA_P95=20
# Precios del modelo en USD por millón de tokens (verificar en la web del proveedor)
PRECIO_ENTRADA_USD_MILLON=0.15
PRECIO_SALIDA_USD_MILLON=0.60
# Con LANGSMITH_TRACING=true la API oculta entradas y salidas en las trazas
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
